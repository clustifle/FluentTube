<Window x:Class="FluentTube.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FluentTube" Title="FluentTube">
  <Grid x:Name="Root" Background="Transparent">
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="AppTitleBar" Background="Transparent" Padding="16,0,138,0">
      <StackPanel x:Name="TitleBarContent" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="Assets/Icon32.png" Width="16" Height="16" AutomationProperties.AccessibilityView="Raw"/>
        <TextBlock Text="FluentTube" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="240" CompactPaneLength="48" IsTitleBarAutoPaddingEnabled="False" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" SelectionChanged="Navigate" ItemInvoked="NavigationInvoked" Background="Transparent">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Tag="home" Icon="Home" IsSelected="True"/>
        <NavigationViewItem Content="Shorts" Tag="shorts" Icon="Video"/>
        <NavigationViewItem Content="Watch later" Tag="saved" Icon="Save"/>
        <NavigationViewItem Content="History" Tag="history" Icon="Clock"/>
        <NavigationViewItem Content="Subscriptions" Tag="subscriptions" Icon="People"/>
        <NavigationViewItem x:Name="NowPlayingItem" Content="Now playing" Tag="player" Icon="Play" SelectsOnInvoked="False" IsEnabled="False"/>
        <NavigationViewItemSeparator/>
        <NavigationViewItem Content="Open file" Tag="import" Icon="OpenFile" SelectsOnInvoked="False"/>
        <NavigationViewItemHeader x:Name="ChannelsNavHeader" Content="Followed channels" Visibility="Collapsed"/>
      </NavigationView.MenuItems>
      <Grid x:Name="ContentLayout" Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <AutoSuggestBox x:Name="Search" PlaceholderText="Search YouTube or paste a video link" QueryIcon="Find" QuerySubmitted="SearchSubmitted" AutomationProperties.Name="Search YouTube"/>
          <Button Grid.Column="1" Content="Open file" Click="ImportVideo"/>
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
          <Grid Padding="24">
            <ScrollViewer x:Name="BrowsePanel" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="20">
                <StackPanel.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></StackPanel.ChildrenTransitions>
                <StackPanel Spacing="8">
                  <TextBlock x:Name="PageTitle" Text="Home" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="PageSubtitle" Text="Explore videos or follow channels to build your feed." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Refresh" Click="RefreshPage"/>
                    <Button Content="Add channel" Click="AddChannel"/>
                    <Button x:Name="ImportSubscriptionsButton" Content="Import subscriptions" Click="ImportTakeout" Visibility="Collapsed"/>
                    <Button x:Name="FollowButton" Content="Follow" Click="FollowChannel" Visibility="Collapsed"/>
                    <Button x:Name="ChannelShortsButton" Content="Shorts" Click="OpenChannelShorts" Visibility="Collapsed"/>
                    <ComboBox x:Name="ShortsSourceChoice" MinWidth="180" MaxWidth="260" SelectionChanged="ShortsSourceChanged" Visibility="Collapsed" AutomationProperties.Name="Shorts channel"/>
                    <Button x:Name="ClearHistoryButton" Content="Clear history" Click="ClearWatchHistory" Visibility="Collapsed"/>
                    <ComboBox x:Name="TopicChoice" SelectedIndex="0" SelectionChanged="TopicChanged" MinWidth="130" AutomationProperties.Name="Home topic"><x:String>All</x:String><x:String>Technology</x:String><x:String>Music</x:String><x:String>Gaming</x:String><x:String>Science</x:String><x:String>News</x:String></ComboBox>
                  </StackPanel>
                  <ProgressBar x:Name="BrowseProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                </StackPanel>
                <Border x:Name="EmptyCard" Padding="0,8">
                  <TextBlock x:Name="EmptyState" Text="Search for a video above, or choose Open file to play a video from your device." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
                </Border>
                <GridView x:Name="Videos" IsItemClickEnabled="True" ItemClick="VideoClicked" SelectionMode="None">
                  <GridView.ItemTemplate><DataTemplate x:DataType="local:Video">
                    <Border x:Name="VideoCard" Loaded="VideoCardLoaded" PointerEntered="PrepareVideo" PointerExited="CancelPreparation" Width="290" Margin="0,0,12,16">
                      <StackPanel Spacing="10">
                        <Grid Height="163" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                          <SymbolIcon Symbol="Video" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                          <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/>
                          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#D0000000" CornerRadius="2" Margin="5" Padding="4,1"><TextBlock Text="{x:Bind DurationText}" Foreground="White" FontSize="11"/></Border>
                        </Grid>
                        <StackPanel Spacing="4" Padding="2,0,2,8">
                          <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2" FontWeight="SemiBold"/>
                          <HyperlinkButton Content="{x:Bind Channel}" Click="OpenCardChannel" Padding="0" FontSize="12" HorizontalAlignment="Left"/>
                          <TextBlock Text="{x:Bind Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </StackPanel>
                      <Border.ContextFlyout><MenuFlyout>
                        <MenuFlyoutItem Text="Play" Tag="{x:Bind}" Click="PlayCard"/>
                        <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" Click="QueueCardNext"/>
                        <MenuFlyoutItem Text="Save to Watch later" Tag="{x:Bind}" Click="SaveCard"/>
                        <MenuFlyoutItem Text="Remove from Watch later" Tag="{x:Bind}" Click="RemoveSavedCard"/>
                        <MenuFlyoutItem Text="Open channel" Tag="{x:Bind}" Click="OpenCardChannel"/>
                      </MenuFlyout></Border.ContextFlyout>
                    </Border>
                  </DataTemplate></GridView.ItemTemplate>
                </GridView>
                <Button x:Name="LoadMoreButton" Content="Load more" Click="LoadMore" HorizontalAlignment="Center" Visibility="Collapsed"/>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PlayerPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><Grid RowSpacing="16">
              <Grid.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></Grid.ChildrenTransitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Click="BackToVideos" AutomationProperties.Name="Back to videos" ToolTipService.ToolTip="Back"><SymbolIcon Symbol="Back"/></Button>
                <TextBlock x:Name="VideoTitle" Grid.Column="1" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center"/>
                <StackPanel x:Name="ShortNavigation" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed"><Button x:Name="PreviousShortButton" Click="PreviousShort" ToolTipService.ToolTip="Previous Short (Up)" AutomationProperties.Name="Previous Short"><SymbolIcon Symbol="Previous"/></Button><TextBlock x:Name="ShortPosition" VerticalAlignment="Center"/><Button x:Name="NextShortButton" Click="NextShort" ToolTipService.ToolTip="Next Short (Down)" AutomationProperties.Name="Next Short"><SymbolIcon Symbol="Next"/></Button></StackPanel>
              </Grid>
              <Grid x:Name="VideoFrame" Grid.Row="1" Background="Black" SizeChanged="VideoSlotSizeChanged">
              <Grid x:Name="VideoSurfaceSlot" Background="Black">
                <Grid x:Name="VideoSurface" Background="Black" RequestedTheme="Dark" PointerEntered="RevealPlayerControls" PointerExited="LeaveVideoSurface" PointerMoved="RevealPlayerControls" PointerPressed="RevealPlayerControls" DoubleTapped="VideoDoubleTapped">
                  <MediaPlayerElement x:Name="Player" Stretch="Uniform" AreTransportControlsEnabled="False" AutoPlay="False" IsTabStop="True"/>
                  <Image x:Name="VideoPoster" Stretch="Uniform" IsHitTestVisible="False"/>
                  <Border x:Name="CaptionOverlay" Background="#C0000000" CornerRadius="4" Padding="8,4" Margin="20,0,20,24" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="CaptionText" Foreground="White" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="800"/></Border>
                  <ProgressBar x:Name="LoadingPlayback" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Top" Height="2" IsHitTestVisible="False"/>
                  <Border x:Name="FullscreenHeading" Visibility="Collapsed" VerticalAlignment="Top" Padding="16" Background="#A0000000">
                    <Grid ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="VideoPresentationTitle" Text="{Binding Text, ElementName=VideoTitle}" Foreground="White" FontSize="18" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button x:Name="PipMinimizeButton" Grid.Column="1" Click="MinimizePictureInPicture" Visibility="Collapsed" Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="4" ToolTipService.ToolTip="Minimize" AutomationProperties.Name="Minimize picture in picture"><FontIcon Glyph="&#xE921;" FontSize="12"/></Button><Button x:Name="PresentationReturnButton" Grid.Column="2" Click="ReturnToWindow" ToolTipService.ToolTip="Return to app (Esc)" AutomationProperties.Name="Return to app" Content="Return to app" FontSize="12"/></Grid>
                  </Border>
                  <Border x:Name="PlayerControls" VerticalAlignment="Bottom" Background="#E0202020" Margin="12" Padding="10" CornerRadius="6" GettingFocus="PlayerControlsGettingFocus" PointerEntered="HoldPlayerControls" PointerExited="ReleasePlayerControls">
                    <Grid RowSpacing="8">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="PlayerTimeline" Minimum="0" Maximum="1" ValueChanged="TimelineChanged" AutomationProperties.Name="Video timeline"/><TextBlock x:Name="PlayerTime" Grid.Column="1" Text="0:00 / 0:00" FontSize="12" Foreground="White" VerticalAlignment="Center"/></Grid>
                      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="PlaybackButtons" Orientation="Horizontal" Spacing="4">
                          <Button x:Name="PreviousButton" Click="PreviousVideo" IsEnabled="False" ToolTipService.ToolTip="Previous (P)" AutomationProperties.Name="Previous video" Padding="8"><SymbolIcon Symbol="Previous"/></Button>
                          <Button x:Name="SeekBackwardButton" Click="SeekBackward" ToolTipService.ToolTip="Back 10 seconds (J)" AutomationProperties.Name="Back 10 seconds" Padding="8"><FontIcon Glyph="&#xE7A7;"/></Button>
                          <Button x:Name="PlayPauseButton" Click="TogglePlayPause" ToolTipService.ToolTip="Play or pause (Space)" AutomationProperties.Name="Play or pause" Padding="8"><SymbolIcon Symbol="Play"/></Button>
                          <Button x:Name="SeekForwardButton" Click="SeekForward" ToolTipService.ToolTip="Forward 10 seconds (L)" AutomationProperties.Name="Forward 10 seconds" Padding="8"><FontIcon Glyph="&#xE7A6;"/></Button>
                          <Button x:Name="NextButton" Click="NextVideo" IsEnabled="False" ToolTipService.ToolTip="Next (N)" AutomationProperties.Name="Next video" Padding="8"><SymbolIcon Symbol="Next"/></Button>
                          <Button x:Name="SoundButton" ToolTipService.ToolTip="Volume" AutomationProperties.Name="Volume" Padding="8"><SymbolIcon Symbol="Volume"/><Button.Flyout><Flyout Opened="PlayerMenuOpened" Closed="PlayerMenuClosed"><StackPanel Spacing="12" Width="180"><TextBlock Text="Volume"/><Slider x:Name="PlayerVolume" Minimum="0" Maximum="100" Value="80" ValueChanged="PlayerVolumeChanged" AutomationProperties.Name="Video volume"/><Button Content="Mute / unmute (M)" Click="ToggleMute"/></StackPanel></Flyout></Button.Flyout></Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                          <ComboBox x:Name="PlayerSpeed" Width="76" SelectedIndex="2" SelectionChanged="PlayerSpeedChanged" DropDownOpened="PlayerMenuOpened" DropDownClosed="PlayerMenuClosed" AutomationProperties.Name="Playback speed"><x:String>0.5×</x:String><x:String>0.75×</x:String><x:String>1×</x:String><x:String>1.25×</x:String><x:String>1.5×</x:String><x:String>2×</x:String></ComboBox>
                          <ComboBox x:Name="PlayerQuality" Width="94" SelectionChanged="PlayerQualityChanged" DropDownOpened="PlayerMenuOpened" DropDownClosed="PlayerMenuClosed" AutomationProperties.Name="Video quality"/>
                          <Button x:Name="PipButton" Click="TogglePictureInPicture" ToolTipService.ToolTip="Picture in picture (I)" AutomationProperties.Name="Picture in picture" Padding="8"><FontIcon Glyph="&#xE8A7;"/></Button>
                          <Button x:Name="FullscreenButton" Click="ToggleFullscreen" ToolTipService.ToolTip="Fullscreen (F)" AutomationProperties.Name="Fullscreen" Padding="8"><SymbolIcon Symbol="FullScreen"/></Button>
                          <Button x:Name="MorePlaybackButton" ToolTipService.ToolTip="More playback options" AutomationProperties.Name="More playback options" Padding="8"><SymbolIcon Symbol="More"/><Button.Flyout><MenuFlyout Opened="PlayerMenuOpened" Closed="PlayerMenuClosed"><ToggleMenuFlyoutItem x:Name="RepeatButton" Text="Repeat" Click="ToggleRepeat"/><MenuFlyoutSubItem x:Name="QualityMenu" Text="Quality"/><MenuFlyoutSubItem x:Name="CaptionsMenu" Text="Captions"/><MenuFlyoutItem Text="Picture in picture" Click="TogglePictureInPicture"/><MenuFlyoutItem Text="Copy video link" Click="CopyVideoLink"/><MenuFlyoutItem Text="Watch queue" Click="ShowQueue"/><MenuFlyoutItem Text="Clear upcoming videos" Click="ClearUpcoming"/><MenuFlyoutItem Text="Retry playback" Click="RetryPlayback"/><MenuFlyoutItem Text="Keyboard shortcuts" Click="ShowShortcuts"/></MenuFlyout></Button.Flyout></Button>
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                  <Border x:Name="PipControls" VerticalAlignment="Bottom" Background="#D0202020" Margin="6" Padding="4,0" CornerRadius="4" Visibility="Collapsed" GettingFocus="PlayerControlsGettingFocus" PointerEntered="HoldPlayerControls" PointerExited="ReleasePlayerControls">
                    <Grid ColumnSpacing="4" Height="32"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PipPlayPauseButton" Click="TogglePlayPause" Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="4" AutomationProperties.Name="Play or pause" ToolTipService.ToolTip="Play / pause (Space)"><FontIcon Glyph="&#xE768;" FontSize="14"/></Button><Slider x:Name="PipTimeline" Grid.Column="1" MinHeight="0" Height="24" VerticalAlignment="Center" Minimum="0" Maximum="1" ValueChanged="PipTimelineChanged" AutomationProperties.Name="Picture in picture timeline"/><TextBlock x:Name="PipTime" Grid.Column="2" FontSize="10" Foreground="White" VerticalAlignment="Center" Text="0:00"/><Button x:Name="PipSoundButton" Grid.Column="3" Click="ToggleMute" Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="4" AutomationProperties.Name="Mute or unmute" ToolTipService.ToolTip="Mute / unmute (M)"><FontIcon Glyph="&#xE767;" FontSize="14"/></Button></Grid>
                  </Border>
                </Grid>
              </Grid>
              </Grid>
              <StackPanel Grid.Row="2" Spacing="8">
                <StackPanel Spacing="8"><HyperlinkButton x:Name="WatchChannel" Content="YouTube" Click="OpenWatchChannel" Padding="0" HorizontalAlignment="Left"/><StackPanel x:Name="WatchActions" Orientation="Horizontal" Spacing="8"><Button x:Name="WatchFollowButton" Content="Follow channel" Click="FollowWatchChannel"/><Button Content="Save for later" Click="SaveVideo"/><Button Content="Open on YouTube" Click="OpenInBrowser"/></StackPanel></StackPanel>
                <Expander Header="Description" HorizontalAlignment="Stretch"><ScrollViewer MaxHeight="100"><TextBlock x:Name="VideoDescription" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></Expander>
              </StackPanel>
              <StackPanel x:Name="UpNextPanel" Grid.Column="1" Grid.RowSpan="3" Width="250" Margin="20,0,0,0" Spacing="12">
                <TextBlock Text="Up next" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <ToggleSwitch x:Name="QueueAutoplay" Header="Autoplay next" Toggled="QueueAutoplayChanged"/>
                <ListView x:Name="QueueView" IsItemClickEnabled="True" ItemClick="VideoClicked" SelectionMode="Single" MaxHeight="420"><ListView.ItemTemplate><DataTemplate x:DataType="local:Video"><StackPanel Padding="4,8" Spacing="4"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2"/><TextBlock Text="{x:Bind Channel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
              </StackPanel>
            </Grid></ScrollViewer>
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"/>
                <Expander Header="Appearance" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="20">
                    <ComboBox x:Name="ThemeChoice" Header="Theme" SelectedIndex="0" SelectionChanged="SettingsChanged" MinWidth="220"><x:String>System</x:String><x:String>Light</x:String><x:String>Dark</x:String></ComboBox>
                    <ComboBox x:Name="AccentChoice" Header="Accent color" SelectedIndex="0" SelectionChanged="SettingsChanged" MinWidth="220"><x:String>Blue</x:String><x:String>Purple</x:String><x:String>Green</x:String><x:String>Orange</x:String><x:String>Rose</x:String></ComboBox>
                    <ToggleSwitch x:Name="CompactChoice" Header="Compact video thumbnails" Toggled="SettingsChanged"/>
                  </StackPanel>
                </Expander>
                <Expander Header="Playback" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="20">
                    <ToggleSwitch x:Name="AutoplayChoice" Header="Play automatically when a video opens" IsOn="True" Toggled="SettingsChanged"/>
                    <ToggleSwitch x:Name="LoopChoice" Header="Repeat current video" Toggled="SettingsChanged"/>
                    <ToggleSwitch x:Name="ResumeChoice" Header="Remember playback position" IsOn="True" Toggled="SettingsChanged"/>
                    <ToggleSwitch x:Name="NextChoice" Header="Play next video automatically" Toggled="SettingsChanged"/>
                    <ToggleSwitch x:Name="ShortsNextChoice" Header="Advance to the next Short" IsOn="True" Toggled="SettingsChanged"/>
                    <ToggleSwitch x:Name="PrepareChoice" Header="Prepare videos before opening" IsOn="True" Toggled="SettingsChanged"/>
                    <TextBlock Text="Prepare the first video in a list, hovered videos, and the next autoplay video. This uses network data before playback. Stream links stay in memory for up to ten minutes." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Slider x:Name="VolumeChoice" Header="Default volume" Minimum="0" Maximum="100" Value="80" StepFrequency="5" ValueChanged="SettingsChanged" MinWidth="260"/>
                    <ComboBox x:Name="SpeedChoice" Header="Playback speed" SelectedIndex="2" SelectionChanged="SettingsChanged" MinWidth="220"><x:String>0.5×</x:String><x:String>0.75×</x:String><x:String>1×</x:String><x:String>1.25×</x:String><x:String>1.5×</x:String><x:String>2×</x:String></ComboBox>
                  </StackPanel>
                </Expander>
                <Expander Header="Subscriptions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12"><TextBlock Text="Import your YouTube subscriptions from a Google Takeout ZIP or subscriptions.csv. Existing local follows are kept. No Google Cloud setup or account connection is needed." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Import subscriptions" Click="ImportTakeout"/><HyperlinkButton Content="Open Google Takeout" NavigateUri="https://takeout.google.com/"/></StackPanel><TextBlock Text="In Takeout, select YouTube and YouTube Music, then include only subscriptions. This is a one-time import; changes do not sync with YouTube." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Expander>
                <Expander Header="Startup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ToggleSwitch x:Name="StartupChoice" Header="Open Watch later at startup" Toggled="SettingsChanged"/></Expander>
                <Expander Header="About FluentTube" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="12"><TextBlock Text="FluentTube 1.0 RC1" FontWeight="SemiBold"/><TextBlock Text="WinUI 3 and .NET 10"/><TextBlock Text="Home, channels, local subscriptions, and history work without a Google account. Local follows do not change your YouTube subscriptions. Public video access uses yt-dlp and YouTube feeds; availability and codecs depend on YouTube and Windows." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                </Expander>
                <Button Content="Reset preferences" Click="ResetSettings" Margin="0,8,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" Spacing="8">
          <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" Severity="Warning"/>
          <TextBlock x:Name="StatusText" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </NavigationView>
    <Grid x:Name="FullscreenHost" Grid.RowSpan="2" Background="Black" Visibility="Collapsed"/>
  </Grid>
</Window>
