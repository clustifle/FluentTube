<Window x:Class="FluentTube.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FluentTube" Title="FluentTube">
  <Grid x:Name="Root" Background="Transparent">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="240" CompactPaneLength="48" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" SelectionChanged="Navigate" ItemInvoked="NavigationInvoked" Background="Transparent">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Tag="home" Icon="Home" IsSelected="True"/>
        <NavigationViewItem Content="Watch later" Tag="saved" Icon="Save"/>
        <NavigationViewItemSeparator/>
        <NavigationViewItem Content="Open file" Tag="import" Icon="OpenFile" SelectsOnInvoked="False"/>
      </NavigationView.MenuItems>
      <Grid x:Name="ContentLayout" Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <AutoSuggestBox x:Name="Search" PlaceholderText="Search YouTube or paste a video link" QueryIcon="Find" QuerySubmitted="SearchSubmitted" AutomationProperties.Name="Search YouTube"/>
          <Button Grid.Column="1" Content="Open file" Click="ImportVideo"/>
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
          <Grid Padding="24">
            <ScrollViewer x:Name="BrowsePanel" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="20">
                <TextBlock x:Name="PageTitle" Text="Home" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                <Border x:Name="EmptyCard" Padding="0,8">
                  <TextBlock x:Name="EmptyState" Text="Search for a video above, or choose Open file to play a video from your device." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
                </Border>
                <GridView x:Name="Videos" IsItemClickEnabled="True" ItemClick="VideoClicked" SelectionMode="None">
                  <GridView.ItemTemplate><DataTemplate x:DataType="local:Video">
                    <Border x:Name="VideoCard" Loaded="VideoCardLoaded" Width="290" Margin="0,0,12,16">
                      <StackPanel Spacing="10">
                        <Grid Height="163" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                          <SymbolIcon Symbol="Video" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                          <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/>
                        </Grid>
                        <StackPanel Spacing="4" Padding="2,0,2,8">
                          <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2" FontWeight="SemiBold"/>
                          <TextBlock Text="{x:Bind Channel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate></GridView.ItemTemplate>
                </GridView>
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="PlayerPanel" Visibility="Collapsed" RowSpacing="16">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Click="BackToVideos" AutomationProperties.Name="Back to videos" ToolTipService.ToolTip="Back"><SymbolIcon Symbol="Back"/></Button>
                <TextBlock x:Name="VideoTitle" Grid.Column="1" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center"/>
              </Grid>
              <Border Grid.Row="1" Background="Black"><MediaPlayerElement x:Name="Player" MinHeight="180" AreTransportControlsEnabled="True" AutoPlay="False"/></Border>
              <CommandBar Grid.Row="2" Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Left" IsOpen="False">
                <AppBarButton Icon="Save" Label="Save for later" Click="SaveVideo"/>
                <AppBarButton Icon="OpenFile" Label="Open file" Click="ImportVideo"/>
                <AppBarButton Icon="Go" Label="Open on YouTube" Click="OpenInBrowser"/>
              </CommandBar>
            </Grid>
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"/>
                <Expander Header="Appearance" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="20">
                    <ComboBox x:Name="ThemeChoice" Header="Theme" SelectedIndex="0" SelectionChanged="SettingsChanged" MinWidth="220"><x:String>System</x:String><x:String>Light</x:String><x:String>Dark</x:String></ComboBox>
                    <ComboBox x:Name="AccentChoice" Header="Accent color" SelectedIndex="0" SelectionChanged="SettingsChanged" MinWidth="220"><x:String>Blue</x:String><x:String>Purple</x:String><x:String>Green</x:String><x:String>Orange</x:String><x:String>Rose</x:String></ComboBox>
                    <ToggleSwitch x:Name="CompactChoice" Header="Compact video thumbnails" Toggled="SettingsChanged"/>
                  </StackPanel>
                </Expander>
                <Expander Header="Playback" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="20">
                    <ToggleSwitch x:Name="AutoplayChoice" Header="Play automatically when a video opens" IsOn="True" Toggled="SettingsChanged"/>
                    <ToggleSwitch x:Name="LoopChoice" Header="Repeat current video" Toggled="SettingsChanged"/>
                    <Slider x:Name="VolumeChoice" Header="Default volume" Minimum="0" Maximum="100" Value="80" StepFrequency="5" ValueChanged="SettingsChanged" MinWidth="260"/>
                    <ComboBox x:Name="SpeedChoice" Header="Playback speed" SelectedIndex="2" SelectionChanged="SettingsChanged" MinWidth="220"><x:String>0.5×</x:String><x:String>0.75×</x:String><x:String>1×</x:String><x:String>1.25×</x:String><x:String>1.5×</x:String><x:String>2×</x:String></ComboBox>
                  </StackPanel>
                </Expander>
                <Expander Header="Startup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ToggleSwitch x:Name="StartupChoice" Header="Open Watch later at startup" Toggled="SettingsChanged"/></Expander>
                <Expander Header="About FluentTube" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="12"><TextBlock Text="FluentTube 0.5" FontWeight="SemiBold"/><TextBlock Text="WinUI 3 and .NET 10"/><TextBlock Text="Search and public video playback use yt-dlp. No API key is required. Video availability and supported codecs depend on YouTube and Windows." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                </Expander>
                <Button Content="Reset preferences" Click="ResetSettings" Margin="0,8,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" Spacing="8">
          <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" Severity="Warning"/>
          <TextBlock x:Name="StatusText" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
